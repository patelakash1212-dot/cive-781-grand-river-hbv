ProgramType          PADDS
ObjectiveFunction    GCOP
ModelExecutable      Ost-RAVEN.bat

# ModelSubdir processor_

BeginExtraDirs
Model
EndExtraDirs

BeginFilePairs
GrandRiver_BM_HBV.rvp.tpl; GrandRiver_BM_HBV.rvp
EndFilePairs

BeginParams
# parameter       initial   lower   upper   tx_in   tx_ost   tx_out
par_POROSITY          0.05      0.05    0.30    none    none     none
par_HBV_BETA          6         0.5       7       none    none     none
par_FAST_BASEFLOW     0.3       0.02    0.80    none    none     none
par_MAX_PERC          30        5       80      none    none     none
par_MELT              5.00      2.00    10.00    none    none     none
par_SLOW_BASEFLOW     0.075     0.001   0.20    none    none     none
EndParams

BeginResponseVars
NSE       .\model\output\Diagnostics.csv;      OST_NULL 1 3 ',' yes
RMSE      .\model\output\Diagnostics.csv;      OST_NULL 1 4 ',' yes
KGE       .\model\output\Diagnostics.csv;      OST_NULL 1 5 ',' yes
AbsPBIAS  .\model\output\Absolute_PBIAS.txt;   OST_NULL 0 1 ' ' yes
EndResponseVars

BeginTiedRespVars
NegNSE  1 NSE wsum -1.00
NegKGE  1 KGE wsum -1.00
EndTiedRespVars

BeginGCOP
CostFunction NegNSE
CostFunction RMSE
CostFunction NegKGE
CostFunction AbsPBIAS
PenaltyFunction APM
EndGCOP

BeginConstraints
EndConstraints

RandomSeed 111

BeginPADDSAlg
PerturbationValue 0.20
MaxIterations 50
SelectionMetric Random
EndPADDSAlg