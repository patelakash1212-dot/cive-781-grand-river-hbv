@echo off
cd /d "%~dp0"

cd Model
Raven.exe GrandRiver_BM_HBV -o output

if errorlevel 1 (
    echo Raven failed.
    exit /b 1
)

cd ..

powershell.exe -NoProfile -ExecutionPolicy Bypass -File ".\CreateAbsPBIAS.ps1"

if errorlevel 1 (
    echo Absolute PBIAS calculation failed.
    exit /b 1
)

exit /b 0
